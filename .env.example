WALLABAG_BASE_URL=https://wallabag.example.com
WALLABAG_CLIENT_ID=your-client-id
WALLABAG_CLIENT_SECRET=your-client-secret
WALLABAG_USERNAME=your-username
WALLABAG_PASSWORD=your-password
# Optional: use an existing OAuth token instead of password grant
# WALLABAG_ACCESS_TOKEN=your-access-token
# Optional: refresh token used to renew expired access tokens
# WALLABAG_REFRESH_TOKEN=your-refresh-token
# WALLABAG_TIMEOUT=20
